# All optional. Without any of these the app runs fully offline.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_PRICE_IN_PER_M=0.075
LLM_PRICE_OUT_PER_M=0.30
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
# ATLAS_OFFLINE=1          force the extractive engine even if a key is present
# ATLAS_EMBEDDINGS=hash    skip MiniLM
# ATLAS_RERANKER=          cross-encoder model name, e.g. cross-encoder/ms-marco-MiniLM-L-6-v2
# ATLAS_OPEN_SIGNUP=0      only the first user (admin) can register; admins add others
# ATLAS_HTTPS=1            mark session cookies Secure behind TLS
